{
  "name": "fiscofacil-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "pgfn:importar": "node --env-file-if-exists=.env --import tsx src/pgfn-importar.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "jszip": "^3.10.1",
    "node-forge": "^1.4.3",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "unpdf": "^1.9.1",
    "unzipper": "^0.12.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/unzipper": "^0.10.11",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
