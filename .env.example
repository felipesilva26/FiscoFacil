# Copie para .env e ajuste. Nunca envie o .env para o GitHub.

NODE_ENV=development
PORT=3000

# Banco de dados. Vazio = PGlite local (PostgreSQL embutido, grava em DATA_DIR).
# Em produção, use um PostgreSQL de verdade:
# DATABASE_URL=postgres://usuario:senha@host:5432/fiscofacil
DATABASE_URL=
DATA_DIR=./data/pgdata
STORAGE_DIR=./data/arquivos

# Obrigatório em produção: texto aleatório com 32 ou mais caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origens permitidas para o navegador (separe por vírgula). Vazio = só mesmo domínio.
CORS_ORIGIN=

# Lembretes por e-mail. Sem SMTP_URL, os e-mails só aparecem no log do servidor.
# Exemplo: smtps://usuario:senha@smtp.seudominio.com:465
SMTP_URL=
MAIL_FROM=FiscoFácil <nao-responder@seudominio.com>

# Assistente com IA (opcional). Sem a chave, usa respostas por regras.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# Consulta cadastral por CNPJ (dados abertos). {cnpj} vira os 14 números.
CNPJ_LOOKUP_URL=https://brasilapi.com.br/api/cnpj/v1/{cnpj}

# Integração com a Receita: "mock" (simulado) ou "serpro" (real).
RECEITA_PROVIDER=none   # none (padrão, sem dados), serpro (real) ou mock (só demonstração, dados fictícios)

# Só para RECEITA_PROVIDER=serpro. Preencha com os dados do seu contrato
# e da documentação oficial do Integra Contador (Loja Serpro).
SERPRO_AMBIENTE=trial
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_AUTH_URL=
SERPRO_GATEWAY_URL=
SERPRO_CERT_PFX_PATH=
SERPRO_CERT_PASSWORD=
SERPRO_CONTRATANTE_CNPJ=
SERPRO_SITFIS_SISTEMA=
SERPRO_SITFIS_SERVICO=
SERPRO_SITFIS_VERSAO=

# Dívida ativa (dados abertos da PGFN, públicos). Baixado de madrugada; PGFN_DESLIGADO=1 desliga.
PGFN_BASE_URL=https://dadosabertos.pgfn.gov.br
PGFN_TMP_DIR=./data/pgfn-tmp
# CNPJ que os clientes informam como procurador no e-CAC (o do FiscoFácil / contratante do Integra Contador)
PROCURADOR_CNPJ=
